[Unit]
Description=NeuralCast Admin HTTP API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/NeuralCast
Environment=PYTHONPATH=/root/projects/NeuralCast/src
EnvironmentFile=/root/projects/NeuralCast/.env
ExecStart=/root/projects/NeuralCast/.venv/bin/python -m neuralcast.cli.admin_api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
